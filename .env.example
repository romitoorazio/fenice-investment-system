# Fenice Autonomous Analysis
# Copiare le chiavi nei GitHub Repository Secrets, non commetterle mai nel repository.

# Mercati tradizionali, IPO, ETF, forex, commodities e opzioni
ALPHA_VANTAGE_API_KEY=

# Indicatori macroeconomici FRED
FRED_API_KEY=

# Crypto pubbliche (facoltativa ma raccomandata)
COINGECKO_API_KEY=

# Nuovi token appena aggiunti; richiede piano CoinGecko Pro
COINGECKO_PRO_API_KEY=

# Identificazione richiesta dalla SEC per accesso automatizzato
# Esempio: FeniceInvestmentSystem/1.0 nome@dominio.it
SEC_USER_AGENT=

# Broker integration — configurazione non operativa
# Il broker viene riconosciuto, ma nessuna di queste variabili può abilitare ordini reali.
FENICE_BROKER=directa
FENICE_DIRECTA_MODE=paper

# Impostare true solo dopo verifica esterna dell'effettiva abilitazione Directa API
# e della documentazione tecnica ufficiale disponibile per il conto.
DIRECTA_API_ACCESS_APPROVED=false
DIRECTA_API_CONTRACT_VERIFIED=false

# NON inserire qui numero conto, password, token o altre credenziali Directa.
# Fenice non implementa ancora il trasporto di rete Directa e mantiene il live trading bloccato nel codice.
