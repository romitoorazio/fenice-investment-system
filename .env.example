# Fenice Autonomous Analysis
# Copiare le chiavi nei GitHub Repository Secrets, non commetterle mai nel repository.

# Mercati tradizionali, IPO, ETF, forex, commodities e opzioni
ALPHA_VANTAGE_API_KEY=

# PAPER execution market-data quorum
# Twelve Data: fonte realtime verificata quando venue/freshness/provenance superano i gate.
TWELVE_DATA_API_KEY=
# Controlli conservativi per il tier gratuito.
FENICE_TWELVE_DATA_EXECUTION_PROBES=3
FENICE_TWELVE_DATA_MIN_INTERVAL_MS=9000
FENICE_TWELVE_DATA_429_RETRIES=2

# Alpaca Basic/IEX: seconda famiglia indipendente per il quorum PAPER.
# Il collector accetta anche APCA_API_KEY_ID / APCA_API_SECRET_KEY come alias.
ALPACA_API_KEY=
ALPACA_API_SECRET=
FENICE_ALPACA_EXECUTION_PROBES=3

# Alpha Vantage execution probe: resta fail-closed se il piano non concede realtime entitlement.
FENICE_ALPHA_VANTAGE_EXECUTION_PROBES=3

# Stooq e Yahoo sono usati solo come validazione quando previsto dalla policy;
# non trasformarli in fonti PAPER autorizzate tramite variabili ambiente.
FENICE_STOOQ_EXECUTION_VALIDATION=false

# Indicatori macroeconomici FRED
FRED_API_KEY=

# Crypto pubbliche (facoltativa ma raccomandata)
COINGECKO_API_KEY=

# Nuovi token appena aggiunti; richiede piano CoinGecko Pro
COINGECKO_PRO_API_KEY=

# Identificazione richiesta dalla SEC per accesso automatizzato
# Esempio: FeniceInvestmentSystem/1.0 nome@dominio.it
SEC_USER_AGENT=

# SICUREZZA
# Non aggiungere qui flag che abilitino LIVE trading o connettività broker.
# La campagna PAPER deve restare fail-closed e provider-neutral fino a certificazione esplicita.
